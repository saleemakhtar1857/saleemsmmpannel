{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "pages/**", "use": "@vercel/static" },
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/dashboard", "dest": "/pages/dashboard.html" },
    { "src": "/dashboard.html", "dest": "/pages/dashboard.html" },
    { "src": "/admin", "dest": "/pages/admin.html" },
    { "src": "/admin.html", "dest": "/pages/admin.html" },
    { "src": "/signup", "dest": "/pages/signup.html" },
    { "src": "/signup.html", "dest": "/pages/signup.html" }
  ]
}
